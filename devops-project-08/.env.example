# Copia este archivo a .env y ajusta los valores antes de levantar el stack.

UI_PORT=8888

# Catalog (MariaDB)
CATALOG_DB_NAME=sampledb
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change-me
CATALOG_DB_ROOT_PASSWORD=change-me-root

# Orders (MariaDB)
ORDERS_DB_NAME=orders
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=change-me
ORDERS_DB_ROOT_PASSWORD=change-me-root

# Carts (DynamoDB Local: credenciales ficticias, no usar reales)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
RABBITMQ_MGMT_PORT=15672
