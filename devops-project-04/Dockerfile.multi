# syntax=docker/dockerfile:1

FROM eclipse-temurin:21-jdk-jammy AS base
WORKDIR /app
COPY .mvn/ .mvn
COPY mvnw pom.xml ./
RUN ./mvnw -B dependency:go-offline
COPY src ./src

# ---------- Desarrollo: hot reload + debugger en 8000 ----------
FROM base AS development
EXPOSE 8080 8000
CMD ["./mvnw", "spring-boot:run", "-Dspring-boot.run.profiles=mysql", "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:8000"]

# ---------- Build ----------
FROM base AS build
RUN ./mvnw -B package -DskipTests \
    && mkdir -p target/extracted \
    && java -Djarmode=layertools -jar target/spring-petclinic-*.jar extract --destination target/extracted

# ---------- Producción ----------
FROM eclipse-temurin:21-jre-alpine AS production

LABEL org.opencontainers.image.title="devops-project-04" \
      org.opencontainers.image.description="Spring PetClinic" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN addgroup -S -g 1001 spring && adduser -S -u 1001 -G spring spring

WORKDIR /app
# Capas de Spring Boot: las que cambian menos primero para aprovechar la cache.
COPY --from=build --chown=spring:spring /app/target/extracted/dependencies/ ./
COPY --from=build --chown=spring:spring /app/target/extracted/spring-boot-loader/ ./
COPY --from=build --chown=spring:spring /app/target/extracted/snapshot-dependencies/ ./
COPY --from=build --chown=spring:spring /app/target/extracted/application/ ./

USER spring
EXPOSE 8080

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -Djava.security.egd=file:/dev/./urandom"

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/actuator/health/readiness || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS org.springframework.boot.loader.launch.JarLauncher"]
