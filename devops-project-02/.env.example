# Copiar a .env y ajustar. NUNCA commitear el .env real.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8002
DJANGO_SECURE_COOKIES=false
DJANGO_LOG_LEVEL=INFO
DJANGO_DB_PATH=/app/data/db.sqlite3
